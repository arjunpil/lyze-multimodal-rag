# ── Lyze Backend Configuration ──────────────────────────────────────────────
# Copy this file to .env inside the /backend folder

# ── Provider choices ── ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama
LLM_MODEL=mistral

VISION_PROVIDER=ollama
VISION_MODEL=llava

EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

WHISPER_MODEL=base

# ── API Keys (only needed if not using Ollama) ───────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=multimodal_rag
